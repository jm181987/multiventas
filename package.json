{
  "name": "multiventas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @multiventas/db prisma:generate",
    "db:migrate": "pnpm --filter @multiventas/db prisma:migrate",
    "db:seed": "pnpm --filter @multiventas/db prisma:seed"
  }
}
