# PostgreSQL ya provisionado. Reemplaza solo placeholders/secrets en Coolify.
DB_HOST=169.58.110.123
DB_PORT=5432
DB_NAME=knj_ventas_multi_store_ventas
DB_USER=knj_ventas_multi_store_ventas_usr
DB_PASSWORD=replace_me

# Prisma usa estas URLs. No subas la contraseña real al repositorio.
DATABASE_URL=postgresql://knj_ventas_multi_store_ventas_usr:replace_me@169.58.110.123:5432/knj_ventas_multi_store_ventas?connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://knj_ventas_multi_store_ventas_usr:replace_me@169.58.110.123:5432/knj_ventas_multi_store_ventas

REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_32_plus_chars
JWT_REFRESH_SECRET=replace_with_32_plus_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 32 bytes en base64. Ejemplo para generar: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key

MP_CLIENT_ID=replace_me
MP_CLIENT_SECRET=replace_me
# Opcional: si se deja vacío, se deriva de WEB_PUBLIC_URL como:
# https://tu-dominio/api/payments/mercadopago/callback
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=replace_me
MP_WEBHOOK_URL=https://api.example.com/api/webhooks/mercadopago
MP_MARKETPLACE_FEE_RATE=0.08

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=multiventas
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://media.example.com

API_PORT=3001
API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_MP_PUBLIC_KEY=replace_me

SEED_ADMIN_PASSWORD=ChangeMeNow123!
SEED_VENDOR_PASSWORD=ChangeMeNow123!
